<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:ChronoGit.Views"
             xmlns:vm="using:ChronoGit.ViewModels"
             xmlns:m="using:ChronoGit.Models"
             x:Class="ChronoGit.Views.RewordView"
             x:DataType="vm:RewordViewModel">

    <UserControl.Resources>
        <vm:SelectionToColorConverter x:Key="SelectionToColorConverter"/>
    </UserControl.Resources>

    <Grid Height="60" RowDefinitions="10,*,*,10" ColumnDefinitions="5,60,10,100,*"
          Background="{Binding Selected, Converter={StaticResource SelectionToColorConverter}}">
        <Path Data="M 0,0 L 10,30 L 0,60 Z" Fill="#000000"
              Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left"
              IsVisible="{Binding ChangedSelection}"/>

        <v:CommitIconView Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" Text="{Binding Id}"/>
        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding MessageShort}" TextDecorations="Strikethrough" Foreground="Gray" FontSize="16"/>
        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding FullAuthor}"/>

        <Path Data="M 0,0 L -10,30 L 0,60 Z" Fill="#000000"
              Grid.Row="0" Grid.Column="5" HorizontalAlignment="Right"
              IsVisible="{Binding ChangedSelection}"/>
    </Grid>
</UserControl>
